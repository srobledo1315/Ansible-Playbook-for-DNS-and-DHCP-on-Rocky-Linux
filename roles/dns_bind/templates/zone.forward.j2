$TTL 86400
@   IN  SOA     ns1.{{ domain_name }}. admin.{{ domain_name }}. (
                2026091001 ; Serial
                3600       ; Refresh
                1800       ; Retry
                604800     ; Expire
                86400 )    ; Minimum TTL

; Name servers
@   IN  NS      ns1.{{ domain_name }}.

; Host records
{% for record in dns_records %}
{{ record.name }}  IN  A   {{ record.ip }}
{% endfor %}
